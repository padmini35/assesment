    // Example for Pascal’s Triangle (#16)
    static void pattern16(int n) {
        System.out.println("\nPattern 16 (Pascal's Triangle):");
        for (int line = 0; line < n; line++) {
            int num = 1;
            for (int space = 0; space < n - line; space++) System.out.print("  ");
            for (int i = 0; i <= line; i++) {
                System.out.print(num + "   ");
                num = num * (line - i) / (i + 1);
            }
            System.out.println();
        }
    }

    // Example for Palindromic Pyramid (#30)
    static void pattern30(int n) {
        System.out.println("\nPattern 30:");
        for (int i = 1; i <= n; i++) {
            for (int space = 1; space <= n - i; space++) System.out.print("  ");
            for (int j = i; j >= 1; j--) System.out.print(j + " ");
            for (int j = 2; j <= i; j++) System.out.print(j + " ");
            System.out.println();
        }
    }

