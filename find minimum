public class FindMinimumRotatedArrayII {
    public static int findMin(int[] nums) {
        int left = 0, right = nums.length - 1;

        while (left < right) {
            int mid = left + (right - left) / 2;

            if (nums[mid] > nums[right]) {
                // Minimum must be in the right half
                left = mid + 1;
            } else if (nums[mid] < nums[right]) {
                // Minimum is in the left half including mid
                right = mid;
            } else {
                // nums[mid] == nums[right], cannot decide → shrink right
                right--;
            }
        }

        return nums[left];
    }

    public static void main(String[] args) {
        int[] nums1 = {1,3,5};
        int[] nums2 = {2,2,2,0,1};

        System.out.println("Minimum in nums1: " + findMin(nums1)); // Output: 1
        System.out.println("Minimum in nums2: " + findMin(nums2)); // Output: 0
    }
}
