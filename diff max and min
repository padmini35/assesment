import java.util.*;

public class DifferencePriceSum {
    private List<List<Integer>> graph;
    private int[] price;
    private long result;

    public long maxDifference(int n, int[][] edges, int[] price) {
        this.graph = new ArrayList<>();
        this.price = price;
        for (int i = 0; i < n; i++) graph.add(new ArrayList<>());
        for (int[] e : edges) {
            graph.get(e[0]).add(e[1]);
            graph.get(e[1]).add(e[0]);
        }
        result = 0;
        dfs(0, -1);
        return result;
    }

    private long dfs(int node, int parent) {
        long maxChild = 0;
        for (int nei : graph.get(node)) {
            if (nei == parent) continue;
            maxChild = Math.max(maxChild, dfs(nei, node));
        }
        result = Math.max(result, maxChild + price[node] - price[node]); // difference
        return maxChild + price[node];
    }

    public static void main(String[] args) {
        DifferencePriceSum solver = new DifferencePriceSum();
        int n = 6;
        int[][] edges = {{0,1},{1,2},{1,3},{3,4},{3,5}};
        int[] price = {9,8,7,6,10,5};
        System.out.println(solver.maxDifference(n, edges, price)); // Output: 24
    }
}
